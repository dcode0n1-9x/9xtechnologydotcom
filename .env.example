# ==============================================================================
# 9xTechnologydotcom — Environment Variables Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# NOTE: Variables prefixed with `NEXT_PUBLIC_` are exposed to the browser.
# Never place production secrets or private API keys in NEXT_PUBLIC_* variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEPLOYMENT & METADATA (Recommended for Production)
# ------------------------------------------------------------------------------
# The canonical public base URL of the site without a trailing slash.
# Used for:
#   - OpenGraph & Twitter preview card image URLs (`/9xtechnology-og.png`)
#   - Canonical URL tags in `<head>`
#   - PWA start URL and manifest resolution
#
# Examples:
#   Production:  https://9xtechnology.com
#   Staging:     https://staging.9xtechnology.com
#   Local Dev:   http://localhost:3000
#
# Fallback: If omitted, Next.js checks `VERCEL_PROJECT_PRODUCTION_URL` on Vercel,
# or defaults to relative paths.
NEXT_PUBLIC_SITE_URL=https://9xtechnology.com

# ------------------------------------------------------------------------------
# 2. DEMO SANDBOX CREDENTIALS (Optional / Configurable)
# ------------------------------------------------------------------------------
# Demo password for the instant trading account sandbox:
#   Account ID: 77777
#   Server:     9xTechnology-Demo01
#
# Behavior:
#   - If provided: The demo password is pre-filled, copyable, and mask/unmaskable.
#   - If left empty (""): The UI automatically switches to "Request from CTO"
#     mode and hides the copy button.
#
# Default fallback: Test@12345
NEXT_PUBLIC_DEMO_PASSWORD=Test@12345

# ------------------------------------------------------------------------------
# 3. OPTIONAL RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# Port for local dev or custom node server (Next.js default is 3000)
# PORT=3000

# CI environment flag (used by Playwright / test runners)
# CI=false
